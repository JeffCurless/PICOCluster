#!/usr/bin/bash
# build — compile picoCluster firmware variants into builds/ and collect the
#         .uf2 images in kits/.
#
# Usage:
#   ./build           build every variant          (same as "all")
#   ./build all       build every variant
#   ./build D         Pico W + Display Pack        (240x135)
#
# Display Pack 2 is not built for now (RP2040 SRAM is too tight with WiFi;
# revisit with Pico 2 W).
#   ./build tests     build and run the host-native unit tests (tests/build)
#
# Build tree:   builds/<board>_<display>/   e.g. builds/picow_D
# Output:       kits/picocluster_<display>-v<CLUSTER_VER_MAJOR.MINOR.EDIT>.uf2
#
# Override the SDK path: PICO_SDK_PATH=/path/to/pico-sdk ./build
# Override picotool:     PICOTOOL_FETCH_FROM_GIT_PATH=/path/to/picotool-install ./build

set -u
cd "$(dirname "$0")" || exit 1

SDK="${PICO_SDK_PATH:-$HOME/workspace/pico-sdk}"

# The SDK insists on a matching picotool version and finds it through its
# CMake package config, not PATH. Use a locally built picotool when one is
# installed (flat install: <dir>/picotool/picotoolConfig.cmake).
# Override: PICOTOOL_FETCH_FROM_GIT_PATH=/path/to/picotool-install ./build
if [ -z "${PICOTOOL_FETCH_FROM_GIT_PATH:-}" ] && [ -d "$HOME/workspace/picotool-install/picotool" ]; then
    export PICOTOOL_FETCH_FROM_GIT_PATH="$HOME/workspace/picotool-install"
fi
JOBS="$(nproc)"
BOARD="picow"          # Pico 2 W support to be added later

run_tests() {
    echo "--- tests ---"
    cmake -B tests/build tests/   || return 1
    make -j"$JOBS" -C tests/build || return 1
    ctest --test-dir tests/build --output-on-failure
}

case "${1:-all}" in
    tests)
        run_tests
        exit $?
        ;;
    all) VARIANTS="D" ;;
    D)   VARIANTS="D" ;;
    *)
        echo "Usage: $0 [all|D|tests]" >&2
        exit 1
        ;;
esac

if [ ! -f picoOS/src/CMakeLists.txt ]; then
    echo "picoOS submodule missing — run: git submodule update --init" >&2
    exit 1
fi

fail() {
    echo "" >&2
    echo "BUILD FAILED: $1" >&2
    exit 1
}

build_variant() {
    local disp="$1"
    local dir="builds/${BOARD}_${disp}"
    echo "--- ${BOARD} / ${disp} ---"
    cmake -B "$dir" -DPICO_SDK_PATH="$SDK" -DPICO_BOARD="$BOARD"        || return 1
    make -j"$JOBS" -C "$dir"                                              || return 1
}

for disp in $VARIANTS; do
    build_variant "$disp" || fail "${BOARD} / ${disp}"
done

echo ""
echo "Done. kits/ contents:"
ls -1 kits/*.uf2
